{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/claude/mods/hud"
  }
}
