##
# Fonts
##
font-family = SF Mono
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 18
font-thicken = true
alpha-blending = native

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

##
# Theme
##
theme = light:everforest-light-hard.ghostty,dark:everforest-dark-hard.ghostty

##
# Eye candy
##
custom-shader = ./shaders/cursor-warp.glsl
# custom-shader = ./shaders/snow.glsl
custom-shader-animation = true

##
# Misc
##
quit-after-last-window-closed = true
link-url = true
shell-integration-features = no-title,ssh-terminfo
window-inherit-working-directory = false
confirm-close-surface = false

##
# System
##
auto-update = download
auto-update-channel = stable

##
# Keybindings
##

# Switch tabs with Cmd and arrow keys
keybind = cmd+left=previous_tab
keybind = cmd+right=next_tab

# Optional local config
config-file = ?~/.ghostty-local.conf
