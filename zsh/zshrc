# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

setopt extendedglob

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -e ~/.localrc ]]; then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}; do
  source $file
done

# load system files first (for environment variables like XDG_*)
for file in ${(M)${${config_files:#*/path.zsh}:#*/completion.zsh}:#*/system/*.zsh}; do
  source $file
done

# load everything else but the path, completion, and system files
for file in ${${${config_files:#*/path.zsh}:#*/completion.zsh}:#*/system/*.zsh}; do
  source $file
done

# Autocomplete. Loading the dump with -C skips compinit's slow scan; rebuild it
# only when it's missing or a completion dir changed (e.g. a new install)
autoload -Uz compinit
() {
  local dump=$XDG_CACHE_HOME/zsh/zcompdump dir

  for dir in $fpath; do
    if [[ ! -s $dump || $dir -nt $dump ]]; then
      mkdir -p ${dump:h}
      rm -f $dump
      compinit -d $dump
      return
    fi
  done

  compinit -C -d $dump
}

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}; do
  source $file
done

unset config_files

# direnv: per-directory env via .envrc (e.g. AZURE_CONFIG_DIR to scope az logins
# per project). Hooked here, after every PATH change and the prompt setup.
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

# zsh-syntax-highlighting must be sourced last, after every other widget
() {
  local prefix=${HOMEBREW_PREFIX:-/opt/homebrew}
  local file=$prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

  [[ -f $file ]] && source $file
}

