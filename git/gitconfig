[user]
  name = Fredrik Frodlund
  email = fredrik@frodlund.se
  signingkey = ~/.ssh/id_ed25519.pub
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[core]
  editor = nvim
  excludesfile = ~/.gitignore
  quotepath = false
  autocrlf = input
[mergetool]
  keepBackup = true
[push]
  default = current
  autoSetupRemote = true
[pull]
  rebase = true
[rebase]
  autoStash = true
  updateRefs = true
[fetch]
  prune = true
[rerere]
  enabled = true
[merge]
  conflictStyle = zdiff3
[diff]
  algorithm = histogram
  colorMoved = default
[init]
  defaultBranch = main
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
[commit]
  gpgsign = true
