# Usage: extract <file> [file …]
# Description: extracts archives / mounts disk images
# Note: .dmg/hdiutil is macOS-only; .7z and .rar need p7zip and unrar.
extract() {
  local file
  for file in "$@"; do
    if [[ ! -f $file ]]; then
      echo "'$file' is not a valid file" >&2
      continue
    fi

    case ${file:l} in
      *.tar.*|*.tgz|*.tbz2|*.txz|*.tar) tar -xvf "$file" ;; # tar detects gz/bz2/xz/zst itself
      *.zip) unzip "$file" ;;
      *.7z) 7z x "$file" ;;
      *.rar) unrar x "$file" ;;
      *.gz) gunzip -k "$file" ;;
      *.bz2) bunzip2 -k "$file" ;;
      *.xz) unxz -k "$file" ;;
      *.zst) unzstd "$file" ;;
      *.z) uncompress "$file" ;;
      *.dmg) hdiutil mount "$file" ;;
      *) echo "'$file' cannot be extracted via extract()" >&2 ;;
    esac
  done
}
